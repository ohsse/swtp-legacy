# 군산 테스트 스택 전용 프런트 빌드 (docker-compose.gunsan.yml)
# ---- 1단계: Vue 빌드 ----
# 운영 Dockerfile은 dist/ 사전 빌드를 전제하므로, 로컬용은 빌드 스테이지를 포함
FROM node:18 AS build
WORKDIR /app
ENV NODE_OPTIONS=--max-old-space-size=4096
COPY package.json package-lock.json ./
# package-lock.json이 package.json과 불일치(echarts-stat, ol 등 누락)라 npm ci 불가 → npm install 사용
# --legacy-peer-deps: ag-grid 27/30, bootstrap-vue 2/3 혼재로 peer 의존성 충돌 우회
RUN npm install --legacy-peer-deps
COPY . .
# 군산 전용 소스 패치(리포 원본 무수정 원칙) — $area가 라우터 구성 자체를 결정하므로
# gosan으로 두면 군산 DB에 고산 화면이 뜬다. 군산 대시보드/라우트를 쓰려면 gunsan이어야 한다.
#
# 백엔드 주소는 더 이상 패치하지 않는다. $apiURL/$pythonURL 이 '/ems-api', '/epa' 상대경로라
# 브라우저가 이 프런트와 같은 오리진(8300)으로 보내고 default.conf 의 nginx 가 컨테이너
# 서비스명으로 넘긴다. 예전에는 호스트 포트(9001/23003)로 돌려놨는데, 그건 브라우저가 절대
# URL 로 직접 붙던 시절 이야기다. 이제 호스트 포트를 어떻게 시프트하든 프런트는 영향이 없다.
# grep은 치환 실패 시 빌드를 즉시 깨뜨리기 위한 검증(Dockerfile.local과 동일 방식)
RUN sed -i 's#$area = "gosan"#$area = "gunsan"#' src/main.js \
 && grep -n -e '$area = "gunsan"' src/main.js \
 && grep -n -e '$apiURL = "/ems-api"' -e '$pythonURL = "/epa"' src/main.js
# 루트(/) 진입 시 토큰이 없으면 운영 자율운영 포털(localhost:10021/login)로 튄다 — 폐쇄망이라 접속 불가.
# 로컬 테스트 토큰 URL로 돌려 자동 로그인되게 한다(router/index.js:345-354, 라우터 생성 시 1회 실행).
RUN sed -i 's#window.location.href = `${autoURL}:${serverPort}/login`;#console.warn("[local] SSO portal skipped, port", serverPort); window.location.href = "/local-test-kwater1";#' src/router/index.js \
 && grep -n 'local-test-kwater1' src/router/index.js
# 주의: 이 스택에는 PMS가 없으므로 Dockerfile.local의 pmsURL 패치는 넣지 않는다.
#       /pms 링크는 고산 운영망(localhost:10015) 하드코딩으로 남아 로컬에서 죽은 링크가 된다.

# inpEditor 의 호스트 노출 포트를 번들에 인라인한다. 컨테이너 내부는 항상 30090 이고 호스트
# 매핑만 스택마다 다른데, EmsSubMenu 의 window.open 은 브라우저에서 도는 코드라 호스트 포트를
# 알아야 한다. compose 의 inp-editor-fe ports: 왼쪽 값과 반드시 같아야 한다.
ARG INP_EDITOR_PORT=30090
ENV VUE_APP_INP_EDITOR_PORT=$INP_EDITOR_PORT

RUN npm run build

# ---- 2단계: nginx 서빙 (운영 Dockerfile과 동일 구성) ----
FROM nginx:stable-alpine
RUN rm -rf /usr/share/nginx/html/*
COPY --from=build /app/dist /usr/share/nginx/html
COPY default.conf /etc/nginx/conf.d/default.conf
EXPOSE 10013
CMD ["nginx", "-g", "daemon off;"]
