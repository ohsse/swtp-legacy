{
  "version": 1,
  "disable_existing_loggers": true,
  "formatters": {
    "basic": {
      "format": "[%(asctime)s] %(module)s:%(levelname)s:%(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "stream": "ext://flask.logging.wsgi_errors_stream",
      "level": "DEBUG",
      "formatter": "basic"
    },
    "file_logging": {
      "class": "logging.handlers.TimedRotatingFileHandler",
      "level": "INFO",
      "formatter": "basic",
      "filename": "log/flask-wntr4wn.log",
      "when": "midnight",
      "delay": true,
      "backupCount": 20
    },
    "log_crit": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "ERROR",
      "formatter": "basic",
      "filename": "log/critical/flask-wntr4wn(critical).log",
      "maxBytes": 512000,
      "backupCount": 10
    }
  },
  "root": {
    "level": "DEBUG",
    "handlers": ["console", "file_logging","log_crit"]
  }
}