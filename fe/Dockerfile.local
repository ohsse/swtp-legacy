# ---- 1단계: Vue 빌드 ----
# 운영 Dockerfile은 dist/ 사전 빌드를 전제하므로, 로컬용은 빌드 스테이지를 포함
FROM node:18 AS build
WORKDIR /app
ENV NODE_OPTIONS=--max-old-space-size=4096
COPY package.json package-lock.json ./
# package-lock.json이 package.json과 불일치(echarts-stat, ol 등 누락)라 npm ci 불가 → npm install 사용
# --legacy-peer-deps: ag-grid 27/30, bootstrap-vue 2/3 혼재로 peer 의존성 충돌 우회
RUN npm install --legacy-peer-deps
COPY . .
# 로컬 실행용 소스 패치(리포 원본 무수정 원칙) — EMS→PMS 화면 이동을 로컬 컨테이너로 돌리기 위해:
#  1) pmsURL이 고산 운영망(localhost:10015) 하드코딩이라 로컬에서 접속 불가 → 로컬 pms-front(호스트 10400)로
#  2) 루트(/) 진입 시 토큰이 없으면 운영 자율운영 포털(localhost:10011/login)로 튄다
#     — 폐쇄망이라 로컬에서 접속 불가. 로컬 테스트 토큰 URL로 돌려 자동 로그인되게 한다
#     (router/index.js:345-354는 네비게이션 가드가 아니라 라우터 생성 시 1회 실행되는 코드다)
#  3) /pms 진입 시 토큰을 붙이면 PMS의 중복 `/:token?` 라우트 중 첫 번째(고산 Dashboard_G)가 매칭되어
#     학야 덤프로 고산 대시보드가 뜬다 → 토큰 없이 루트로 보내 PMS가 area(hakya)로 대시보드를 고르게 함
#     (토큰 선언까지 함께 지운다 — 남겨두면 no-unused-vars로 빌드가 깨진다. auto 라우트의 동일 코드가
#      영향받지 않도록 /pms 라우트 블록 안으로 치환 범위를 한정)
RUN sed -i 's#^const pmsURL = "http://localhost:10015"; //gosan#const pmsURL = "http://localhost:8400"; //local pms-front#' src/router/index.js \
 && sed -i '/path: "\/pms\/:token?"/,/props: true,/ { s#const token = localStorage.getItem("token");##; s#const url = token ? `${pmsURL}/${token}` : `${pmsURL}`;#const url = pmsURL;#; }' src/router/index.js \
 && sed -i 's#window.location.href = `${autoURL}:${serverPort}/login`;#console.warn("[local] SSO portal skipped, port", serverPort); window.location.href = "/local-test-kwater1";#' src/router/index.js \
 && grep -n -e 'localhost:8400' -e 'const url = pmsURL' -e 'local-test-kwater1' src/router/index.js

# inpEditor 의 호스트 노출 포트를 번들에 인라인한다. 컨테이너 내부는 항상 30090 이고 호스트
# 매핑만 스택마다 다른데, EmsSubMenu 의 window.open 은 브라우저에서 도는 코드라 호스트 포트를
# 알아야 한다. compose 의 inp-editor-fe ports: 왼쪽 값과 반드시 같아야 한다.
ARG INP_EDITOR_PORT=30090
ENV VUE_APP_INP_EDITOR_PORT=$INP_EDITOR_PORT

RUN npm run build

# ---- 2단계: nginx 서빙 (운영 Dockerfile과 동일 구성) ----
FROM nginx:stable-alpine
RUN rm -rf /usr/share/nginx/html/*
COPY --from=build /app/dist /usr/share/nginx/html
COPY default.conf /etc/nginx/conf.d/default.conf
EXPOSE 10013
CMD ["nginx", "-g", "daemon off;"]
